# =============================================================================
# MODE 2 — CHAY BANG DOCKER / DOCKER COMPOSE (PHP 8.4 + Nginx + PostgreSQL 17)
# Su dung: Copy-Item .env.docker.example .env
#          docker compose up -d --build
#          docker compose exec app php artisan key:generate
#          docker compose exec app php artisan migrate:fresh --seed
# =============================================================================
APP_NAME="Smart Canteen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Cong expose ra may host (Nginx trong container nghe :8080 -> host :8000)
API_PORT=8000
DB_FORWARD_PORT=54329

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Ket noi toi service "postgres" ben trong mang Docker Compose
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=titkul_canteen_demo
DB_USERNAME=demo_user
DB_PASSWORD=demo_secret_local

# Cho phep Mini App (chay Local hoac Docker tren :3000) & Zalo WebView
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://h5.zdn.vn,zbrowser://h5.zdn.vn

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@smartcanteen.local"
MAIL_FROM_NAME="${APP_NAME}"

# Xac thuc & Can tin So (Che do Docker Dev/Demo)
DEMO_LOGIN_ENABLED=true
BANKING_GATEWAY_DRIVER=sandbox
BANKING_WEBHOOK_SECRET=local-sandbox-webhook-secret-change-me
BANKING_EXPOSE_DEBUG_OTP=true
BANKING_AUTO_PROVISION_DEMO_CARD=true
ZALO_APP_ID=
ZALO_APP_SECRET=

# VNPay Sandbox (URL trinh duyet goi ra cong host :8000)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/api/v1/payments/vnpay/return
VNPAY_SANDBOX_SIMULATOR_ENABLED=true

# SMS OTP Gateway (log | esms | twilio)
SMS_DRIVER=log
SMS_BRANDNAME=SmartCanteen
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SMS_TYPE=2
ESMS_SANDBOX=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Thong bao Push (log | zalo_oa | zalo_zns)
NOTIFICATION_PUSH_DRIVER=log
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
ZALO_ZNS_SANDBOX=true
