APP_NAME="Smart Canteen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=titkul_canteen_demo
DB_USERNAME=demo_user
DB_PASSWORD=demo_secret_local

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://h5.zdn.vn

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@smartcanteen.local"
MAIL_FROM_NAME="${APP_NAME}"

DEMO_LOGIN_ENABLED=true
BANKING_GATEWAY_DRIVER=mock
BANKING_EXPOSE_DEBUG_OTP=true
BANKING_AUTO_PROVISION_DEMO_CARD=true
ZALO_APP_ID=
ZALO_APP_SECRET=
