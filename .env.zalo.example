# =============================================================================
# MODE 3 — CHAY TREN ZALO MOBILE (Zalo Mini App Development / Testing)
# Yeu cau bat buoc: Backend phai chay qua HTTPS cong khai (Cloudflare Tunnel / VPS)
#                   va dien ZALO_APP_ID + ZALO_APP_SECRET tu Zalo Developer Center.
# Su dung: Copy-Item .env.zalo.example .env -> dien cac gia tri YOUR_*
#          php artisan key:generate && php artisan config:clear
# =============================================================================
APP_NAME="Smart Canteen"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_HTTPS_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Neu chay Backend bang Docker: giu DB_HOST=postgres, DB_PORT=5432
# Neu chay Backend thuan Local: doi DB_HOST=127.0.0.1, DB_PORT=54329
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=titkul_canteen_demo
DB_USERNAME=demo_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Chi cho phep origin cua Zalo Mini App WebView (Android + iOS)
CORS_ALLOWED_ORIGINS=https://h5.zdn.vn,zbrowser://h5.zdn.vn

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@smartcanteen.local"
MAIL_FROM_NAME="${APP_NAME}"

# Bao mat: Tat Demo Login va khong tra debug_otp qua API khi test tren Zalo Mobile
DEMO_LOGIN_ENABLED=false
BANKING_GATEWAY_DRIVER=sandbox
BANKING_WEBHOOK_SECRET=CHANGE_ME_RANDOM_64_CHAR_SECRET
BANKING_EXPOSE_DEBUG_OTP=false
BANKING_AUTO_PROVISION_DEMO_CARD=true

# Dien thong tin tu https://mini.zalo.me/developers/ (bat quyen getPhoneNumber)
ZALO_APP_ID=YOUR_ZALO_MINI_APP_ID
ZALO_APP_SECRET=YOUR_ZALO_APP_SECRET

# VNPay Sandbox qua domain HTTPS cong khai
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://YOUR_HTTPS_DOMAIN/api/v1/payments/vnpay/return
VNPAY_SANDBOX_SIMULATOR_ENABLED=false

# SMS OTP Gateway (log neu chua mua SMS; doi sang esms | twilio khi gui SMS that)
SMS_DRIVER=log
SMS_BRANDNAME=SmartCanteen
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SMS_TYPE=2
ESMS_SANDBOX=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Thong bao Push Zalo OA / ZNS (log | zalo_oa | zalo_zns)
NOTIFICATION_PUSH_DRIVER=log
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
ZALO_ZNS_SANDBOX=true
